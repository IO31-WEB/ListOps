# ============================================================
# ListOps Environment Variables
# Copy to .env.local (local) and set the same names in Vercel
# (Project -> Settings -> Environment Variables -> Production).
# NEVER commit real values. .gitignore already excludes .env*.
# Variables starting with NEXT_PUBLIC_ are visible in the browser —
# only put things there that are safe to be public.
# ============================================================

# ── Clerk Authentication ─────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxx   # public by design
CLERK_SECRET_KEY=sk_live_xxxx                    # SECRET
CLERK_WEBHOOK_SECRET=whsec_xxxx                  # SECRET
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Database (Neon PostgreSQL) ────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/db?sslmode=require   # SECRET

# ── Anthropic (Claude AI) ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxx                    # SECRET — use a dedicated workspace key
GENERATION_MODEL=claude-sonnet-5                 # consumer campaign model
COMMERCIAL_MODEL=claude-opus-5-5                 # commercial routes model
# Spend caps (USD, estimated). Also set a HARD monthly limit in console.anthropic.com.
AI_DAILY_BUDGET_USD=40
AI_MONTHLY_BUDGET_USD=400
AI_USER_DAILY_BUDGET_USD=4

# ── Property enrichment (optional public-records auto-fill) ───
# auto = Realie first, RentCast fallback | realie | rentcast | none (disables the feature)
ENRICHMENT_PROVIDER=auto
REALIE_API_KEY=xxxx                              # SECRET
RENTCAST_API_KEY=xxxx                            # SECRET

# ── Stripe Billing ────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxx  # public by design
STRIPE_SECRET_KEY=sk_live_xxxx                   # SECRET
STRIPE_WEBHOOK_SECRET=whsec_xxxx                 # SECRET
STRIPE_STARTER_MONTHLY_PRICE_ID=price_xxxx
STRIPE_STARTER_YEARLY_PRICE_ID=price_xxxx
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxxx
STRIPE_PRO_YEARLY_PRICE_ID=price_xxxx
STRIPE_COMMERCIAL_MONTHLY_PRICE_ID=price_xxxx
STRIPE_COMMERCIAL_YEARLY_PRICE_ID=price_xxxx
STRIPE_BROKERAGE_MONTHLY_PRICE_ID=price_xxxx
STRIPE_BROKERAGE_YEARLY_PRICE_ID=price_xxxx

# ── Commercial integrations ───────────────────────────────────
DATA_PUSH_WEBHOOK_SECRET=xxxx                    # SECRET (HMAC for /api/commercial/data-push)
ATTOM_API_KEY=xxxx                               # SECRET
GOOGLE_PLACES_API_KEY=AIza_xxxx                  # SECRET — restrict by API + IP in Google Cloud

# ── Cloudflare R2 (photo & file storage) ─────────────────────
R2_ACCOUNT_ID=xxxx
R2_ACCESS_KEY_ID=xxxx                            # SECRET
R2_SECRET_ACCESS_KEY=xxxx                        # SECRET
R2_BUCKET_NAME=listops-assets
NEXT_PUBLIC_R2_PUBLIC_URL=https://assets.listops.io   # public bucket domain — used ONLY for brand-kit logos/headshots. Listing photos are served same-origin via /api/photos/* and do not need a public bucket.

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_xxxx                           # SECRET
RESEND_FROM_EMAIL=hello@listops.io               # MUST be on your verified Resend domain
SUPPORT_EMAIL=support@listops.io                 # receives contact-form messages; used as reply-to
MAIL_FOOTER_ADDRESS=ListOps LLC, 123 Main St, Suite 100, City, ST 00000   # REQUIRED: marketing email is refused without it (CAN-SPAM)
UNSUBSCRIBE_SECRET=generate-a-long-random-string-32+chars   # SECRET: signs unsubscribe links (openssl rand -base64 32). Marketing email is refused without it.

# ── App Config ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://listops.io
NEXT_PUBLIC_APP_NAME=ListOps

# ── Upstash Redis (rate limiting + AI spend counters) ────────
# Free databases are deleted after 14 days of inactivity — use pay-as-you-go for production.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx                    # SECRET

# ── PostHog (analytics) ───────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxx                 # public by design
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=phx_xxxx                         # SECRET (server-side events)

# ── Sentry (error tracking) ───────────────────────────────────
SENTRY_DSN=https://xxx@o000.ingest.sentry.io/000
NEXT_PUBLIC_SENTRY_DSN=https://xxx@o000.ingest.sentry.io/000   # DSNs are write-only identifiers, safe to expose

# ── Legal / compliance ────────────────────────────────────────
# DMCA designated agent — must EXACTLY match what you file with the U.S. Copyright Office (see LEGAL_AND_LAUNCH_CHECKLIST.md)
DMCA_AGENT_NAME=
DMCA_AGENT_COMPANY=ListOps
DMCA_AGENT_ADDRESS=
DMCA_AGENT_PHONE=
DMCA_AGENT_EMAIL=dmca@listops.io
# Optional: require an explicit "I agree to the Terms" checkbox on Stripe Checkout.
# Set the Terms URL in Stripe Dashboard -> Settings -> Public details FIRST, otherwise checkout will error.
STRIPE_REQUIRE_TOS=false
# Content-Security-Policy: false/unset = report-only (safe). true = enforcing. Redeploy after changing.
CSP_ENFORCE=false

# ── Scheduled jobs ────────────────────────────────────────────
# Protects /api/cron/* (Vercel Cron sends it automatically as a Bearer token). openssl rand -base64 32
CRON_SECRET=generate-a-long-random-string-32+chars

# ── Feature flags (optional) ──────────────────────────────────
# FLAG_BROKERAGE_EARLY_ACCESS=false  FLAG_PRO_EARLY_ACCESS=false  FLAG_NEW_DASHBOARD=false
# FLAG_PDF_DISABLED=false            FLAG_STREAMING=false

# ── Flyer PDF renderer ─────────────────────────────────────────────────────────
# Optional. Signs the 3-minute token that lets the headless browser open one flyer. Defaults to CLERK_SECRET_KEY.
PRINT_TOKEN_SECRET=
